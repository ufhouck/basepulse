# Base Pulse — Environment Variables
# Copy this to .env.local and fill in the values

# OpenSea API Key (get one at https://opensea.io/settings/developer)
OPENSEA_API_KEY=

# Neynar API Key (get one at https://neynar.com — required for notifications)
NEYNAR_API_KEY=

# Alchemy (for NFT activity webhook notifications)
ALCHEMY_AUTH_TOKEN=
ALCHEMY_WEBHOOK_ID=

# Base Chain ID (don't change)
NEXT_PUBLIC_BASE_CHAIN_ID=8453
